{
  "name": "stevefenton.co.uk",
  "type": "module",
  "version": "1.0.20",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "refresh": "pnpm version patch && pnpm update && node ./accelerator.js && pnpm css-version",
    "update-node": "bash -c 'source $NVM_DIR/nvm.sh && nvm install --lts && npm install -g pnpm'",
    "build": "pnpm css-version && astro build",
    "clean": "rm -rf dist && rm -rf .log",
    "crawl": "linkinator ./dist --skip \"^(?!http://localhost)\" --skip \"/404/\" --recurse  --verbosity error",
    "css-version": "node ./src/themes/accelerator/utilities/css-version.mjs",
    "cve": "cve-lite .",
    "dev": "pnpm css-version && node ./src/themes/accelerator/utilities/img.mjs && astro dev",
    "img": "node ./src/themes/accelerator/utilities/img.mjs",
    "img:reset": "rimraf --glob 'public/img/**/*.json'",
    "preview": "astro preview",
    "stats": "node ./src/themes/accelerator/utilities/stats.mjs",
    "spellcheck": "git fetch origin main:refs/remotes/origin/main && git diff origin/main --name-only --diff-filter=ACMRTUXB | cspell --no-must-find-files --file-list stdin",
    "spellcheckall": "cspell \"**\"",
    "theme": "pnpm update && node ./accelerator.js"
  },
  "devDependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@img/sharp-linux-x64": "^0.35.5",
    "astro-accelerator": "^7.1.29",
    "astro-accelerator-utils": "^0.3.111",
    "cspell": "^10.3.5",
    "cve-lite-cli": "^1.37.0",
    "linkinator": "7.0.0",
    "optional": "^0.1.4",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.5"
  }
}
